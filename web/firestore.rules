rules_version = '2';

// このアプリではクライアント(ブラウザ/Android)から Firestore に直接アクセスしない。
// 書き込みは /api/locations、読み取りは地図ページのサーバコンポーネントが
// いずれも Admin SDK 経由で行うため、クライアント SDK からのアクセスは全て拒否する。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
