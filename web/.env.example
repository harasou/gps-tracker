# ---- ローカル開発用の環境変数サンプル ----
# このファイルをコピーして .env.local を作る:
#   cp .env.example .env.local
# .env.local は git 管理外(.gitignore 済み)。

# Android アプリからの POST を認証する共有トークン(任意の長いランダム文字列)
# 生成例: openssl rand -hex 32
DEVICE_TOKEN=change-me-to-a-long-random-string

# Google Maps JavaScript API キー
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ローカルで Firestore を叩くための管理者クレデンシャル。
# Firebase コンソールで発行したサービスアカウント JSON へのパスを指定する。
# 本番(App Hosting)では自動で用意されるため不要。
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ローカルで使う Firebase プロジェクト ID
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
